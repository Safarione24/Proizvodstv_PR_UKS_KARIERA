# База данных (уберите, если используете PostgreSQL/MySQL и хотите сохранить локальную базу)
*.sqlite3
*.db

# Виртуальное окружение
.venv/
venv/
env/
ENV/
HyperionEnv/

# Файлы конфигурации и секреты
.env
*.env
local_settings.py
secrets.json

# Кэш Python
**/__pycache__/
*.py[cod]
*$py.class

# Статика и медиа (загрузки пользователей)
/media/

# Если вы собираете статику через collectstatic в отдельную папку:
/staticfiles/

# Логи
*.log
logs/

# Настройки сред разработки (IDE)
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Системные файлы
.DS_Store
Thumbs.db
